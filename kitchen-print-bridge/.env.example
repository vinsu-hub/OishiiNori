# Copy to .env and fill in. Never commit .env.
API_BASE_URL=https://oishii-nori-api.vercel.app
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Dedicated low-privilege "Kitchen Printer" account (see README 1a)
BRIDGE_EMAIL=
BRIDGE_PASSWORD=
# Serial port the OS exposes for the paired Bluetooth printer (e.g. COM5, /dev/rfcomm0)
BT_PORT=COM5
BT_BAUDRATE=9600
POLL_INTERVAL_SECONDS=20
PAPER_WIDTH_CHARS=32
# Orders older than this are never printed (protects against stale queued orders)
MAX_TICKET_AGE_HOURS=12
