{
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/dashboard", "destination": "https://oishii-nori-dashboard.vercel.app" },
    { "source": "/dashboard/:path*", "destination": "https://oishii-nori-dashboard.vercel.app/:path*" },

    { "source": "/menu", "destination": "https://oishii-nori-menu.vercel.app" },
    { "source": "/menu/:path*", "destination": "https://oishii-nori-menu.vercel.app/:path*" },

    { "source": "/staff-clock", "destination": "https://oishii-nori-staff-clock.vercel.app" },
    { "source": "/staff-clock/:path*", "destination": "https://oishii-nori-staff-clock.vercel.app/:path*" },

    { "source": "/api", "destination": "https://oishii-nori-api.vercel.app" },
    { "source": "/api/:path*", "destination": "https://oishii-nori-api.vercel.app/:path*" },

    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
